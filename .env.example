# === Database ===
# Keep POSTGRES_* in sync with infra/.env and Docker. The API rebuilds DATABASE_URL
# from these values (embedded password in DATABASE_URL alone can drift and cause auth errors).
POSTGRES_USER=cm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=circuitmind
DATABASE_URL=postgresql+asyncpg://cm:changeme@localhost:5432/circuitmind

# === Redis ===
# REDIS_URL host/port kept; password is taken from REDIS_PASSWORD (avoids drift like Postgres).
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379

# === AI ===
# Provider: "anthropic" (default) or "ollama"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (used when LLM_PROVIDER=ollama)
# Install: https://ollama.com  then: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# === App ===
SECRET_KEY=changeme-generate-a-real-secret-key
ENVIRONMENT=development

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
